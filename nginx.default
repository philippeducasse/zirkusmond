 
# nginx.default

server {
    listen 8000;
    server_name zirkusmond.de;

    location / {
        proxy_pass http://127.0.0.1:8010;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
    location /static/ {
        root /srv/data/;
    }
        #echo "uri $uri";
        #echo "request uri: $request_uri";

    #    if ($uri ~* static/(.*)) {
    #        set $smaller_uri $1;
    #    }
        #echo "foobar $smaller_uri";
        # replace static with static_

    #    try_files /srv/data/srv_static $smaller_uri;
        #if ($request_uri ~* /a/(.*)/(.*)){
        #    set $tmp /$1/$2;
        #    rewrite ^ $tmp break;
        #    }
    #}
    location /media/ {
        root /srv/data/;
    }
    client_max_body_size 10M;
}
